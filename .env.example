# =============================================================================
# biosciences-temporal Environment Configuration
# =============================================================================
#
# KEY OWNERSHIP NOTE:
# biosciences-temporal runs the biosciences-mcp gateway as a LOCAL SUBPROCESS
# via MCPServerStdio (see agents/base.py: create_mcp_client).
# It passes `env = os.environ.copy()` to the subprocess, so all biosciences-mcp
# API keys (BIOGRID_API_KEY, NCBI_API_KEY, etc.) must be set here too —
# not because temporal uses them directly, but because the MCP subprocess needs them.
# See biosciences-mcp/.env.example for the full list of API keys required.
#
# BIOSCIENCES_API_KEY is only needed when using the HTTP cloud endpoint
# (biosciences-mcp.fastmcp.app) instead of the local stdio subprocess.
# =============================================================================

# REQUIRED: Pydantic AI Gateway key (PydanticAI agents call Claude through the gateway;
# routing is configured in agents/base.py). Download from Logfire → Gateway.
# Note: the scripts/ entry points load this file with override=True, so values
# here win over shell exports. Other entry points see only the shell environment.

# Base URL has no route suffix: the route is appended by gateway_provider().
# Copy only the API key line from a Logfire credentials download; its
# route-qualified PYDANTIC_AI_GATEWAY_BASE_URL would double the path.
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-us.pydantic.dev/proxy
PYDANTIC_AI_GATEWAY_API_KEY=pylf_v2_us_your-gateway-key-here

# OPTIONAL: Anthropic model the agents request through the gateway
# Default: claude-sonnet-5 (see agents/base.py: MODEL)
# BIOSCIENCES_MODEL=claude-sonnet-5

# REQUIRED (passed through to biosciences-mcp subprocess):
# Get FREE key at: https://webservice.thebiogrid.org/
BIOGRID_API_KEY=your-biogrid-api-key-here

# OPTIONAL (passed through to biosciences-mcp subprocess — increases NCBI rate limits 3→10 req/s):
# Get FREE key at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=your-ncbi-api-key-here

# OPTIONAL: Custom path to biosciences-mcp repository
# Default: Automatically detects ../biosciences-mcp/ sibling directory
# BIOSCIENCES_MCP_PATH=/custom/path/to/biosciences-mcp
