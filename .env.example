# =============================================================================
# biosciences-temporal Environment Configuration
# Aligned with news-agent-temporal/.env.example
# =============================================================================

# Temporal Connection
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=biosciences-task-queue

# PydanticAI / TypeSafe (Jev) Decision Model (optional tier-1 decision router)
TYPESAFE_API_KEY=
TYPESAFE_MODEL_NAME=jev-latest

# OpenRouter Free Models & Fallbacks ($0 token spend; Nemotron Lightning supports native tool calling)
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Optional Per-Activity / Per-Agent Model Overrides (BIOSCIENCES_MODEL_<AGENT_NAME_UPPER>)
# Valid agent names (see docs/inspect.json):
#   ANCHOR_RESOLVE, ENRICH_PROTEIN, EXPAND_INTERACTIONS, TRAVERSE_DRUGS,
#   TRAVERSE_TRIALS, VALIDATE_GENE, VALIDATE_DRUG, VALIDATE_TRIAL, VALIDATE_SL
# BIOSCIENCES_MODEL_ANCHOR_RESOLVE=nvidia/nemotron-3.5-lightning:free
# BIOSCIENCES_MODEL_VALIDATE_SL=openrouter/free

# Logfire & OpenTelemetry Instrumentation (in-process OTel; no gateway proxy needed)
LOGFIRE_TOKEN=
LOGFIRE_READ_TOKEN=

# Sibling biosciences-mcp Subprocess Keys (passed via MCPServerStdio env=os.environ.copy())
# Get FREE BioGRID key at: https://webservice.thebiogrid.org/
BIOGRID_API_KEY=your-biogrid-api-key-here
# Optional FREE NCBI key (increases rate limits 3->10 req/s): https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=your-ncbi-key-here
# Optional custom path to sibling biosciences-mcp repo (defaults to ../biosciences-mcp)
# BIOSCIENCES_MCP_PATH=/custom/path/to/biosciences-mcp
